# Salinan template — installer membuat versi final di /etc/systemd/system/sessionhub.service
[Unit]
Description=SessionHub - DSLRBooth session uploader
After=network.target

[Service]
Type=simple
User=sessionhub
WorkingDirectory=/opt/sessionhub
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
